{
  "name": "cemu",
  "version-string": "3.0-dev",
  "homepage": "https://ce-programming.github.io/CEmu/",
  "description": "Developer-oriented emulator of the eZ80-based TI-84 Plus CE / TI-83 Premium CE calculators.",
  "dependencies": [
    "pkgconf",
    "libiconv",
    "libusb",
    "lua",
    {
      "name": "sol2",
      "version>=": "3.5.0#1"
    },
    {
      "name": "libarchive",
      "default-features": false
    },
    {
      "name": "libpng",
      "features": [ "apng" ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [ "gui", "network", "widgets", "png" ],
      "platform": "windows"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [ "gui", "network", "widgets", "png", "dbus" ],
      "platform": "osx"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [ "gui", "network", "widgets", "png", "dbus", "fontconfig", "xcb" ],
      "platform": "linux"
    }
  ],
  "builtin-baseline": "127402f1c75bb3d5ff6bce04b285faa4930a5aca"
}
