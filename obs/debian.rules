#!/usr/bin/make -f

# OBS may unpack the upstream tarball below the Debian packaging directory.
CEMU_SOURCE_DIR := $(if $(wildcard gui/qt/CMakeLists.txt),.,cemu-3.0)

%:
	dh $@ --buildsystem=cmake+ninja --sourcedirectory=$(CEMU_SOURCE_DIR)/gui/qt --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCEMU_DEPENDENCY_PROVIDER=system -DBUILD_SHARED_LIBS=ON \
		-DCEMU_DEPLOY_RUNTIME=OFF -DCEMU_EXECUTABLE_NAME=cemu \
		-DSHORT_VERSION=v3.0

# The Qt CMake project does not define a test target.
override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install
	install -Dm644 $(CEMU_SOURCE_DIR)/LICENSE debian/cemu/usr/share/doc/cemu/copyright
