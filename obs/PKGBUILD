pkgname=cemu
pkgver=3.0
pkgrel=0
pkgdesc='TI-84 Plus CE / TI-83 Premium CE emulator.'
arch=('i686' 'x86_64' 'aarch64')
url='https://github.com/CE-Programming/CEmu'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'zlib' 'libpng' 'libarchive' 'libusb' 'lua54' 'hicolor-icon-theme' 'shared-mime-info')
makedepends=('cmake>=3.24' 'ninja' 'git' 'pkgconf' 'sol2>=3.5')
source=("$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP')

build() {
  cmake -S "${srcdir}/${pkgname}-${pkgver}/gui/qt" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCEMU_DEPENDENCY_PROVIDER=system -DBUILD_SHARED_LIBS=ON \
    -DCEMU_DEPLOY_RUNTIME=OFF -DCEMU_EXECUTABLE_NAME=cemu \
    -DSHORT_VERSION="v${pkgver}"
  cmake --build build --parallel
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
